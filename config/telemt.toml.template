[general]
use_middle_proxy = false
log_level = "normal"
data_path = "/var/lib/telemt"
quota_state_path = "/var/lib/telemt/telemt.limit.json"

[general.modes]
classic = true
secure = false
tls = false

[general.links]
show = "*"

[server]
port = 8443

[server.api]
enabled = true
listen = "0.0.0.0:9091"
whitelist = ["0.0.0.0/0"]
auth_header = "Bearer __TELEMT_API_TOKEN__"
read_only = false
minimal_runtime_enabled = false

[[server.listeners]]
ip = "0.0.0.0"

[censorship]
tls_domain = "__TELEMT_TLS_DOMAIN__"
mask = true
tls_emulation = false

[access.users]
teleproxy_bootstrap = "__TELEMT_BOOTSTRAP_SECRET__"

[access.user_enabled]
teleproxy_bootstrap = false
