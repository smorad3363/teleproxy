#!/usr/bin/env bash
set -Eeuo pipefail

INSTALL_DIR=${TPROXY_INSTALL_DIR:-/opt/teleproxy}
STATE_FILE="$INSTALL_DIR/state/install.env"
SOURCE_DIR="$INSTALL_DIR/source"
[[ -f "$STATE_FILE" ]] || { echo "Teleproxy is not installed at $INSTALL_DIR" >&2; exit 1; }

read_state_value() {
  awk -F= -v k="$2" '$1 == k {sub(/^[^=]*=/, ""); print; found=1; exit} END {exit found ? 0 : 1}' "$1"
}

compose() {
  docker compose --project-name teleproxy --env-file "$STATE_FILE" -f "$SOURCE_DIR/compose.yaml" "$@"
}

panel_port=$(read_state_value "$STATE_FILE" TPROXY_PANEL_PORT)
panel_bind=$(read_state_value "$STATE_FILE" TPROXY_PANEL_BIND)
admin_user=$(read_state_value "$STATE_FILE" TPROXY_ADMIN_USER)
proxy_port=$(read_state_value "$STATE_FILE" TPROXY_PROXY_PORT 2>/dev/null || printf '443')

container_running() {
  local service=$1 label=$2 id running
  id=$(compose ps -q "$service" 2>/dev/null || true)
  if [[ -z "$id" ]]; then
    printf '%s: container missing\n' "$label" >&2
    return 1
  fi
  running=$(docker inspect -f '{{.State.Running}}' "$id" 2>/dev/null || true)
  if [[ "$running" == "true" ]]; then
    printf '%s: running\n' "$label"
    return 0
  fi
  printf '%s: not running\n' "$label" >&2
  return 1
}

proxy_health() {
  local id status
  id=$(compose ps -q telemt 2>/dev/null || true)
  [[ -n "$id" ]] || { echo "Proxy Plane: not running"; return 1; }
  status=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)
  printf 'Proxy Plane: %s (port %s)\n' "${status:-unknown}" "$proxy_port"
  [[ "$status" == "healthy" ]]
}

case "${1:-status}" in
  status)
    compose ps
    ;;
  logs)
    shift || true
    compose logs --tail=200 "$@"
    ;;
  restart)
    compose restart control
    ;;
  start)
    compose up -d
    ;;
  stop)
    compose stop
    ;;
  doctor)
    docker info >/dev/null
    failed=0
    if compose config --quiet >/dev/null 2>&1; then
      echo "Compose: valid"
    else
      echo "Compose: invalid" >&2
      failed=1
    fi
    container_running control "Control container" || failed=1
    container_running telemt "Telemt container" || failed=1
    if curl -fsS --max-time 3 "http://127.0.0.1:${panel_port}/readyz" >/dev/null; then
      echo "Control Plane: ready"
    else
      echo "Control Plane: not ready" >&2
      failed=1
    fi
    proxy_health || failed=1
    if [[ "$failed" == "1" ]]; then
      compose ps >&2 || true
      exit 1
    fi
    ;;
  proxy)
    case "${2:-status}" in
      status) proxy_health ;;
      restart) compose restart telemt ;;
      logs) compose logs --tail=200 telemt ;;
      *) echo "usage: tproxy proxy {status|restart|logs}" >&2; exit 2 ;;
    esac
    ;;
  config)
    cat "$STATE_FILE"
    ;;
  panel)
    host=127.0.0.1
    if [[ "$panel_bind" != "127.0.0.1" ]]; then
      detected=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
      [[ -n "$detected" ]] && host=$detected
    fi
    printf 'Panel URL:  http://%s:%s\n' "$host" "$panel_port"
    printf 'Admin User: %s\n' "$admin_user"
    ;;
  *)
    echo "usage: tproxy {status|logs|restart|start|stop|doctor|proxy|config|panel}" >&2
    exit 2
    ;;
esac
